{"file":"busiest-sites.sql","sql":"-- Which sites turned up the most species?\nselect t.name, t.habitat, count(distinct g.species_id) as species, sum(g.count) as birds\nfrom sites t\njoin checklists c on c.site_id = t.id\njoin sightings g on g.checklist_id = c.id\ngroup by t.id\norder by species desc;","columns":[{"name":"name","type":"text","align":"left"},{"name":"habitat","type":"text","align":"left"},{"name":"species","type":"int8","align":"right"},{"name":"birds","type":"int8","align":"right"}],"rows":[["Minsmere","reedbed","27","186"],["Cley Marshes","saltmarsh","25","387"],["Dungeness","shingle","24","336"],["Loch Garten","pine forest","23","251"],["Wicken Fen","fen","21","203"],["Titchwell Marsh","saltmarsh","21","691"],["Bempton Cliffs","sea cliff","19","388"],["Spurn Point","coastal spit","19","275"],["Slimbridge","wetland","16","276"],["Portland Bill","headland","16","464"],["Farne Islands","island","13","734"],["Nagshead","oak wood","9","44"]],"rowCount":12,"durationMs":2,"runMs":2}