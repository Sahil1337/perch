{"file":"spring-migration.sql","sql":"-- First arrivals of spring\nselect s.common_name, to_char(min(g.seen_at), 'YYYY-MM-DD') as first_seen, sum(g.count) as birds\nfrom sightings g\njoin species s on s.id = g.species_id\nwhere s.migrant\ngroup by s.common_name\norder by first_seen;","columns":[{"name":"common_name","type":"text","align":"left"},{"name":"first_seen","type":"text","align":"left"},{"name":"birds","type":"int8","align":"right"}],"rows":[["Chiffchaff","2026-03-07","18"],["Sand Martin","2026-03-13","253"],["Garganey","2026-03-16","17"],["Wheatear","2026-03-16","38"],["Blackcap","2026-03-26","22"],["Barn Swallow","2026-03-31","214"],["Puffin","2026-03-31","595"],["Willow Warbler","2026-04-05","16"],["House Martin","2026-04-05","60"],["Yellow Wagtail","2026-04-10","26"],["Osprey","2026-04-12","9"],["Kittiwake","2026-04-13","392"],["Sedge Warbler","2026-04-16","11"],["Nightingale","2026-04-19","6"],["Whitethroat","2026-04-19","11"],["Grasshopper Warbler","2026-04-19","1"],["Cuckoo","2026-04-20","3"],["Sandwich Tern","2026-04-22","73"],["Whinchat","2026-04-25","9"],["Redstart","2026-04-27","1"],["Pied Flycatcher","2026-04-27","3"],["Arctic Tern","2026-04-29","106"],["Reed Warbler","2026-05-01","7"],["Little Tern","2026-05-01","12"],["Swift","2026-05-03","177"],["Wryneck","2026-05-03","1"],["Common Tern","2026-05-07","73"],["Hobby","2026-05-15","8"],["Turtle Dove","2026-05-17","1"],["Golden Oriole","2026-05-19","1"],["Wood Warbler","2026-05-20","2"],["Spotted Flycatcher","2026-05-30","1"],["Red-backed Shrike","2026-05-30","1"]],"rowCount":33,"durationMs":9,"runMs":9}