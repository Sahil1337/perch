# Compiled binaries and the archives built from them.
dist/
release/

# The frontend bundle copied in by scripts/build.sh. The directory itself is committed (with
# only .gitkeep) because //go:embed needs it to exist in a clean checkout — which is also why
# it is not called "dist": the root .gitignore excludes every dist/, and git will not descend
# into an excluded directory to re-include a file inside it.
webui/static/*
!webui/static/.gitkeep
