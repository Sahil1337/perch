{
  "name": "perch-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for perch: the `perch` server/CLI, the web UI, and the packages they share.",
  "type": "module",
  "license": "MIT",
  "author": "Sahil1337 (https://github.com/Sahil1337)",
  "homepage": "https://github.com/Sahil1337/perch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sahil1337/perch.git"
  },
  "bugs": {
    "url": "https://github.com/Sahil1337/perch/issues"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22",
    "bun": ">=1.2"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "turbo run dev --filter=perch",
    "dev:ui": "turbo run dev --filter=@perch/web",
    "build": "bun run --filter '*' build",
    "start": "turbo run start --filter=perch",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint apps/server/src packages/ui/src && bun run --filter @perch/web lint",
    "smoke": "bun run --filter perch smoke",
    "perch": "perch",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/server/dist apps/server/ui apps/web/.next apps/web/out .turbo apps/*/.turbo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@shadcn/lint": "^0.1.0",
    "eslint": "^10.10.0",
    "turbo": "^2.10.13",
    "typescript-eslint": "^8.70.0"
  }
}
